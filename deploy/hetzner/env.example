# Copy this file to env.production on the new server. Never commit env.production.
COMPOSE_PROJECT_NAME=openbot
OPENBOT_IMAGE_TAG=local

# Use sibling custom domains under the same organizational domain. This keeps authentication
# first-party while the app runs on Vercel and the API runs on Hetzner.
OPENBOT_API_HOST=api.openbot.example.com
OPENBOT_APP_ORIGIN=https://openbot.example.com
TLS_EMAIL=platform@example.com

# Generate independent values for each secret. Suggested commands are documented in README.md.
POSTGRES_PASSWORD=replace-me
KEY_ENCRYPTION_KEY=replace-me
BETTER_AUTH_SECRET=replace-me
COMPUTER_TOKEN=replace-me
SUPERVISOR_TOKEN=replace-me

GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
INITIAL_ADMIN_EMAILS=admin@example.com

INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=replace-me
COPILOTKIT_LICENSE_TOKEN=replace-me

# Configure one provider and its model. OpenAI models using the Responses API need the final flag.
BOT_PROVIDER=openai
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BOT_MODEL=
BOT_RESPONSES_API=false

DEPLOYMENT_ID=openbot-production
TENANT_PACKAGE_DIR=../examples/fintech
COMPUTER_NAMESPACE=openbot-production
COMPUTER_NETWORK=openbot-backend
COMPUTER_MEMORY_BYTES=3221225472
COMPUTER_NANO_CPUS=1500000000
COMPUTER_PIDS_LIMIT=512
# COMPUTER_RUNTIME=runsc
# EGRESS_PROXY_DEFAULT=http://user:password@proxy.example.com:8080
# AGENT_COMPUTER_POLICY={"mode":"enforce","deny":[],"allow":["true"]}
